# ==========================================
# CONFIGURACION DE BASE DE DATOS
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_investigacion
DB_USER=investigacion
DB_PASSWORD=postgres

# ==========================================
# CONFIGURACION DE SEGURIDAD
# ==========================================
# Llave de 256 bits (32 bytes) para JWT
APP_JWT_SECRET=super_secret_jwt_key_that_should_be_long_enough_in_prod
# Llave maestra para encriptacion de datos sensibles (AttributeEncryptor)
APP_MASTER_KEY=super_secret_master_key_for_aes_encryption
# Origenes permitidos para CORS (separados por coma)
APP_CORS_ORIGINS=https://appinvestigacion.iamrodrigo.dev,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Activa migracion transparente de hashes antiguos durante login. Mantener false para no ralentizar el primer login.
APP_UPGRADE_PASSWORD_ON_LOGIN=false
