# ==============================================================================
# SisInv (Sistema de Investigación) - Variables de Entorno de Ejemplo
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# Configuración del Servidor Web
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Configuración de Base de Datos PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=sistema_investigacion
DB_USER=investigacion
DB_PASSWORD=postgres_password_segura

# Seguridad y Criptografía
# IMPORTANTE: Generar cadenas aleatorias y seguras para producción
# Clave para firma de tokens JWT (HS256)
APP_JWT_SECRET=cambiar_por_un_jwt_secret_largo_y_seguro_de_al_menos_32_caracteres
# Clave Maestra AES-256-GCM para encriptación de credenciales Google (32 caracteres o más)
APP_MASTER_KEY=clave_maestra_aes_gcm_32_caracteres_minimo_segura!
# Cookie segura (establecer a true cuando se use HTTPS / dominio en producción)
COOKIE_SECURE=false

# Orígenes Permitidos para CORS (separados por coma)
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Directorio de Archivos Estáticos del Frontend
DIR_ESTATICOS_FRONTEND=/app/frontend/dist
