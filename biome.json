{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"ignoreUnknown": false,
		"includes": ["src/**/*", "*.ts", "*.json", "*.mjs"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		}
	}
}
